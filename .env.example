# ---------- Bootstrap (environment only: .env.local locally, host env vars in production) ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/storeboard
# Decrypts the secrets stored in app_settings, so it must never be stored there itself.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------- Everything else is stored in Postgres (app_settings), not here ----------
# SESSION_SECRET, FIREBASE_*, NEXT_PUBLIC_FIREBASE_*, ADMIN_EMAILS, APP_URL,
# WEBHOOK_BASE_URL, SHOPIFY_*, CRON_SECRET, UPSTASH_*. Manage them with
#   npm run settings -- set KEY VALUE     (or `npm run settings -- import` to copy them from .env.local once)
